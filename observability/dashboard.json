      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(vllm:num_requests_running, job)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "job",
